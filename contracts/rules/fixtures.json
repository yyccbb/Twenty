  "rules_doc": "docs/architecture/backend-tech-stack.md §3",
  "constants": {
    "slot_minutes": 20,
    "snap_before_minutes": 15,
    "snap_after_minutes": 5,
    "max_early_slots": 2,
    "max_overlapping_events": 2,
    "reward": {
